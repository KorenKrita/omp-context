{
  "name": "omp-context",
  "version": "0.1.1",
  "description": "Agentic Context Management for OMP — checkpoint, timeline, and travel tools",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "AGENTS.md",
    "CONTEXT.md",
    "implementation-notes.html",
    ".omp-plugin"
  ],
  "scripts": {
    "prepare": "bun scripts/install-git-hooks.mjs",
    "generate:guidance": "bun scripts/generate-guidance.mjs",
    "host:check-local": "bun scripts/precommit-host-contract.mjs --check-only",
    "host:promote-local": "bun scripts/precommit-host-contract.mjs",
    "test:host": "bun run --cwd test/host-fixture verify",
    "verify:acm": "bun scripts/verify-acm.mjs && bun run test && bun run typecheck && bun run test:host",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "17.1.4",
    "@oh-my-pi/pi-ai": "17.1.4",
    "@oh-my-pi/pi-coding-agent": "17.1.4",
    "@oh-my-pi/pi-tui": "17.1.4",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.2",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "17.1.4",
    "@oh-my-pi/pi-ai": "17.1.4",
    "@oh-my-pi/pi-coding-agent": "17.1.4",
    "@oh-my-pi/pi-tui": "17.1.4"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
